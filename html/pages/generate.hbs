
<header>
    <a class="button" id="home" href="/">Home</a>
</header>
<main id="mainContent">
    <form id="generateForm">
        <div>
            <label for="videoId">Video ID</label>
            <input id="videoId" name="id" type="text" value="{{id}}" />
        </div>


        <div id="generationStatus"></div>
    </form>
</main>
<footer>
    <button id="generate">Generate</button>
    <a id="backButton" class="button"
        href="/settings?return=/share-target/?text=https%3A%2F%2Fyoutube.com%3Fv%3D{{id}}&title={{title}}">Back</a>
</footer>
<script>
    const urlParams = new URLSearchParams(window.location.search);

    const title = urlParams.get("title");
    let generating = false;
    const idInput = document.getElementById("videoId");
    idInput.addEventListener("input", (e) => {
        const id = e.target.value;
        document.getElementById("backButton").href = "/settings?return=/share-target/?text=https%3A%2F%2Fyoutube.com%3Fv%3D"+id+"&title="+title;
    });
    if(idInput.value == ""){
        document.getElementById("generateForm").remove();
        document.getElementById("mainContent").innerHTML = "<h1>No video ID provided</h1>";
        document.getElementById("generate").remove();
        document.getElementById("backButton").style.gridColumn = "1 / span 2";
        document.getElementById("backButton").href="/";
    }
    document.getElementById("generate").addEventListener("click", (e) => {
        e.preventDefault();
        if (generating) {
            return;
        }
        
        document.getElementById("generationStatus").textContent = "Generating recipe card...";
        generating = true;
        fetch(`/api/youtube/withCookies?id=${document.getElementById("videoId").value}`, {
            method: "GET"
        }).then(response => {
            if (response.ok) {
                return response.json()
            } else {
                console.log(response);
                document.getElementById("generationStatus").textContent = "Failed to generate recipe card";
                generating = false;
                throw new Error("Failed to generate recipe card");
            }
        }).then((json) => {
            const existing = localStorage.getItem("recipeCards") || "[]";
            const existingArray = JSON.parse(existing);

            existingArray.push({
                ...json,
                title: title
            });

            localStorage.setItem("recipeCards", JSON.stringify(existingArray));
            generating = false;
            document.getElementById("generationStatus").textContent = "Transferring you to recipe cards";
            setTimeout(() => {
                window.location.replace(`/?index=${existingArray.length - 1}`);
            }, 2000);
        })
    });
</script>
<style>
    

    form {
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-rows: 1fr 1fr;
    }

    form>div {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr 2fr;
    }

    #generationStatus {
        display: block;
    }

    label {
        font-size: 3em;
    }

    select,
    input,
    #generationStatus {
        font-size: 2em;
    }

    header {
        grid-template-columns: 1fr;
    }

    footer {
        grid-template-columns: 1fr 1fr;
    }
</style>