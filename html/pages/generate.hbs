

<header>
    <button type="button" id="home">Home</button>
</header>
<main>
    <form id="generateForm">
        <div>
            <label for="id">Video ID</label>
            <input id="id" name="id" type="text" value="{{id}}"/>
        </div>
        
        
        <div id="generationStatus"></div>
    </form>
</main>
<footer>
    <button>Generate</button>
    <a class="button" href="/settings?return=/share-target/?text=https%3A%2F%2Fyoutube.com%3Fv%3D{{id}}">add title to this href</a>
</footer> 
<script>
    const urlParams = new URLSearchParams(window.location.search);
    const title = urlParams.get("title");
    let generating = false;
    document.getElementById("id").addEventListener("input",function(){
        const id = this.value;
        document.querySelector("a").href = "/settings?return=/share-target/?text=https%3A%2F%2Fyoutube.com%3Fv%3D"+id=`&title=${title}`;
    })
    document.getElementById("generateForm").addEventListener("submit",(e)=>{
        e.preventDefault();
        if (generating){
            return;
        }
        document.getElementById("generationStatus").textContent = "Generating recipe card...";
        generating = true;
        fetch(`/api/youtube/withCookies?id=${document.getElementById("id").value}`,{
            method:"GET"
        }).then(response => {
            if (response.ok) {
                return response.json()
            } else {
                console.log(response);
                document.getElementById("generationStatus").textContent = "Failed to generate recipe card";
                generating = false;
                throw new Error("Failed to generate recipe card");
            }
        }).then((json)=>{
            const existing = localStorage.getItem("recipeCards") || "[]";
            const existingArray = JSON.parse(existing);
            
            existingArray.push({
                ...json,
                title:title
            });
            
            localStorage.setItem("recipeCards", JSON.stringify(existingArray));
            generating = false;
            document.getElementById("generationStatus").textContent = "Transferring you to recipe cards";
            setTimeout(()=>{
                window.location.replace("/")
            },2000);
        })
    });
</script>
