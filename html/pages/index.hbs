<header>
    <button type="button" id="Left">Left</button>
    <button type="button" id="Right">Right</button>
</header>
<main>
    <h1 id="recipeName">Recipe</h1>
    <h1 id="recipeNumber"></h1>
    <p id="recipeContent">
        
    </p>
</main>
<footer>
    <button id="deleteButton">Delete</button>
    <button id="shareButton">Share</button>
    <a href="settings" class="button">Settings</a>
</footer> 
<script>
    const urlParams = new URLSearchParams(window.location.search);

    function canBrowserShareFiles() {
        if (!navigator.share || !navigator.canShare) {
            return false;
        }

        // Create some test data with a file, to check if the browser supports
        // sharing it.
        const testFile = new File(["foo"], "foo.txt", { type: "text/plain" });
        const data = { files: [testFile] };

        return navigator.canShare(data);
    }

    let currentRecipe = Number(urlParams.get("index") || 0);
    const recipes = JSON.parse(localStorage.getItem("recipeCards") || "[]");
    if(recipes.length == 0){
        document.getElementById("recipeName").textContent = "No recipe cards found";
        document.getElementById("recipeContent").remove();
        document.getElementById("recipeNumber").remove();

    }
    function changeRecipe(){
        const recipe = recipes[currentRecipe];
        const recipeText = recipe.text.split("\n").join("<br/>");
        document.getElementById("recipeContent").innerHTML = recipeText;
        document.getElementById("recipeName").innerHTML = `${recipe.title || "Untitled recipe"}`;
        document.getElementById("recipeNumber").innerHTML = `${currentRecipe+1}/${recipes.length}`;
    }
    changeRecipe();
    const buttonLeft = document.getElementById("Left");
    const buttonRight = document.getElementById("Right");
    const shareButton = document.getElementById("shareButton");
    const deleteButton = document.getElementById("deleteButton");
    deleteButton.addEventListener("click",()=>{
        window.location.href = `/delete?index=${currentRecipe}`;
    });
    shareButton.addEventListener("click",()=>{
        alert("Sharing recipe...");
        const blob = new Blob([recipes[currentRecipe].text],{ type: "text/plain" });
        if(canBrowserShareFiles()){
             navigator.share({
                title: "My shared file",
                files: [new File([blob], "recipe.txt", { type: "text/plain" })],
            }).catch((err) => console.log("Error sharing:", err));
        } else {
            alert("Your browser does not support sharing files.");
        }
    })
    buttonRight.addEventListener("click", function() {
        currentRecipe+=1;
        if(currentRecipe > recipes.length-1){
            currentRecipe=0;
        }
        changeRecipe();
    });
    
    buttonLeft.addEventListener("click", function() {
        currentRecipe-=1;
        if(currentRecipe < 0){
            currentRecipe=recipes.length-1;
        }
        changeRecipe();
    });


</script>
<style>
    header{
        grid-template-columns:1fr 1fr;
    }
    footer{
        grid-template-columns:1fr 1fr 1fr;
    }
    main{
        overflow-y:auto;
    }
</style>
