<header>
    <div class="box" aria-label="Settings header logo">Settings</div>
</header>
<main>
    <div id ="disclaimer" aria-label="There's a settings form in this section and a back button to go home at the very bottom of the screen.">Read me with screen reader</div>
    <form id="settingsForm">
        <div>
            <label for="cellsPerLine">Cells per Line</label>
            <input value="{{cellsPerLine}}" id="cellsPerLine" name="cellsPerLine" type="number" min="1" step="1" aria-required="true" aria-label="Amount of braile characters per line. Minimum 1"/> 

        </div>
        <div>
            <label for="linesPerPage">Lines per page</label>
            <input value="{{linesPerPage}}" id="linesPerPage" name="linesPerPage" type="number" min="1" step="1" aria-required="true" aria-label="Amount of lines per page."/>
        </div>
        <div>
            <label for="table">Translation Table</label>
            <select id="table" name="table" aria-required="true" aria-label="Select braille translation table">
                <option value="en-ueb-g2.ctb" {{#if (eq table "en-ueb-g2.ctb")}}selected{{/if}}>Grade 2 English</option>
                <option value="en-ueb-g1.ctb" {{#if (eq table "en-ueb-g1.ctb")}}selected{{/if}}>Grade 1 English</option>
            </select>
        </div>
    </form>
</main>

<footer>
    
    <a href="{{#if return}} {{return}} {{else}} /home {{/if}}" class="box">Back</a>
    <a href="/" class="box">Frontpage</a>
</footer>
<script>
    for(const input of [...document.getElementsByTagName("select"),...document.getElementsByTagName("input")]){
        console.log(input.name,input.value,1000);
        input.addEventListener("input",()=>{
            setCookie(input.name,input.value,1000);
        })
        
    }
</script>
<style>
    .visually-hidden{
        display:none;
    }
    main{
        overflow-y: auto;
    }
    form{
        width:100dvw;
        height:100%;
        display:grid;
        grid-template-rows:1fr 1fr 1fr 1fr;
    }
    form > div{
        width:100dvw;
        height:100%;
        display:grid;
        justify-content: center;
        align-items: center;
        grid-template-columns: 1fr 2fr 0fr;
    }
    label{
        font-size:3rem;
    }
    select,input {
        height:100%;
        font-size:2rem;
    }
    footer{
        grid-template-columns:1fr 1fr;
    }
</style>