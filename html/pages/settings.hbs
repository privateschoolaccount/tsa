<header>
    <div class="box">Settings</div>
</header>
<main>
    <form id="settingsForm">
        <div>
            <label for="cellsPerLine">Cells per Line</label>
            <input value="{{cellsPerLine}}" id="cellsPerLine" name="cellsPerLine" type="number"/> 
        </div>
        <div>
            <label for="linesPerPage">Lines per page</label>
            <input value="{{linesPerPage}}" id="linesPerPage" name="linesPerPage" type="number"/>
        </div>
        <div>
            <label for="table">Translation Table</label>
            <select id="table" name="table">
                {{#each tableOptions}}
                    <option value="{{this}}" {{#if (eq this table)}}selected{{/if}}>{{this}}</option>
                {{/each}}
            </select>
        </div>
    </form>
</main>

<footer>
    
    <a href="{{#if return}} {{return}} {{else}} / {{/if}}" class="box">Back</a>
</footer>
<script>
    for(const input of [...document.getElementsByTagName("select"),...document.getElementsByTagName("input")]){
        console.log(input.name,input.value,1000);
        input.addEventListener("input",()=>{
            setCookie(input.name,input.value,1000);
        })
        
    }
</script>
<style>
    body{
        width:100vw;
        height:100vh;
        margin:0;
        display:grid;
        grid-template-rows:1fr 4fr 1fr;
        background-color:white;
    }
    main{
        width:100%;
        height:100%;
    }
    form{
        width:100%;
        height:100%;
        display:grid;
        grid-template-rows:1fr 1fr 1fr 1fr;
    }
    form > div{
        width:100%;
        display:grid;
        grid-template-columns: 1fr 2fr;
    }
    label{
        font-size:3em;
    }
    select,input {
        font-size:2em;
    }
    footer{
        width;100%;
        height:100%;
        display:grid;
        grid-template-columns:1fr;
    }
    header{
        display:grid;
        width:100%;
        height:100%;
        grid-template-columns:1fr;
        grid-template-rows:1fr;
    }
    .box{
        display: grid;
        place-items:center;
        justify-content: center;
        padding: 10px 20px;
        background-color: #007BFF;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        text-align: center;
        font-size: 10vw;
        border: 2px solid black;
        font-family: serif;
    }
    button.box:hover{
        background-color: #0056b3;
        
    }
    h1{
        text-align: center
    }
</style>